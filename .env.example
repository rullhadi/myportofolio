# =============================================================================
# KONFIGURASI PENYIMPANAN GAMBAR CLOUDFLARE (R2 / IMAGES)
# Salin file ini menjadi .env lalu isi sesuai akun Cloudflare Anda
# =============================================================================

# 1. Cloudflare R2 (S3-Compatible Object Storage)
# Masukkan Public Bucket URL atau Custom Domain R2 Anda.
# Contoh jika memakai r2.dev domain:
# VITE_CF_R2_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
# Contoh jika menghubungkan custom domain di R2:
# VITE_CF_R2_URL=https://assets.namadomain.com
VITE_CF_R2_URL=

# 2. Cloudflare Images Delivery
# Masukkan URL delivery Cloudflare Images Anda:
# VITE_CF_IMAGES_URL=https://imagedelivery.net/<ACCOUNT_HASH>
VITE_CF_IMAGES_URL=
